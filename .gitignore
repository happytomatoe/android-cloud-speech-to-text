android/build/
android/.gradle/

# IDE files
.idea/
*.iml

# Local Android SDK path
local.properties

# Built APKs
*.apk

# Keystore files (security sensitive!)
*.jks
*.keystore

# OS-specific files
.DS_Store
Thumbs.db
